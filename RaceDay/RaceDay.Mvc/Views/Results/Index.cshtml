@model List<RaceDay.Contracts.ResultDto>

@{
    ViewData["Title"] = "My Results";
}

<div class="container py-5">
    <h2 class="mb-2">My Race Results</h2>
    <p class="text-muted mb-4">
        View your recorded race results and finishing positions.
    </p>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You do not have any race results yet.
            Your results will appear here once the organiser records them.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Event</th>
                                <th>Category</th>
                                <th>Finishing Time</th>
                                <th>Position</th>
                                <th>Date Recorded</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var result in Model)
                            {
                                <tr>
                                    <td>@result.EventName</td>
                                    <td>@result.CategoryName</td>
                                    <td>@result.FinishTime</td>
                                    <td>@result.FinishingPosition</td>
                                    <td>@result.RecordedAt.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
