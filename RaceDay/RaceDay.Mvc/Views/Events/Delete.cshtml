@model RaceDay.Contracts.EventDto

@{
    ViewData["Title"] = "Delete Event";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow border-danger">
                <div class="card-header bg-danger text-white p-3">
                    <h3 class="mb-0">Delete Event</h3>
                </div>

                <div class="card-body p-4">
                    <div class="alert alert-warning">
                        Are you sure you want to delete this event?
                        This action cannot be undone.
                    </div>

                    <h4>@Model.Name</h4>

                    <p>
                        <strong>Description:</strong>
                        @Model.Description
                    </p>

                    <p>
                        <strong>Date:</strong>
                        @Model.EventDate.ToString("dd MMMM yyyy")
                    </p>

                    <p>
                        <strong>Location:</strong>
                        @Model.Location
                    </p>

                    <p>
                        <strong>Distance:</strong>
                        @Model.DistanceKm km
                    </p>

                    <form asp-controller="Events"
                          asp-action="DeleteConfirmed"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.EventId" />

                        <button type="submit"
                                class="btn btn-danger">
                            Yes, Delete Event
                        </button>

                        <a asp-controller="Events"
                           asp-action="Index"
                           class="btn btn-secondary">
                            Cancel
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

