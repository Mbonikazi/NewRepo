@using Microsoft.AspNetCore.Http
@model List<RaceDay.Contracts.EventDto>

@{
    ViewData["Title"] = "RaceDay Events";

    // Get the currently logged-in user's role.
    var role = Context.Session.GetString("Role");

    // Check whether the user is an Organiser.
    bool isOrganiser = string.Equals(
        role,
        "Organiser",
        StringComparison.OrdinalIgnoreCase
    );
}

<div class="container py-4">

    <!-- Page heading -->
    <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">
        <div>
            <h2 class="fw-bold mb-1">RaceDay Events</h2>
            <p class="text-muted mb-0">
                Browse and manage available sporting events.
            </p>
        </div>

        @if (isOrganiser)
        {
            <a asp-controller="Events"
               asp-action="Create"
               class="btn btn-primary mt-2">
                + Create New Event
            </a>
        }
    </div>

    <!-- Success message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- Error message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger" role="alert">
            @ViewBag.Error
        </div>
    }

    <!-- Events list -->
    @if (Model == null || !Model.Any())
    {
        <div class="card shadow-sm text-center p-5">
            <div class="card-body">
                <h4 class="fw-bold">No Events Available</h4>

                <p class="text-muted">
                    There are currently no events to display.
                </p>

                @if (isOrganiser)
                {
                    <a asp-controller="Events"
                       asp-action="Create"
                       class="btn btn-primary">
                        Create Your First Event
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var eventItem in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">

                    <div class="card h-100 shadow-sm">

                        <!-- Event card heading -->
                        <div class="card-header bg-primary text-white">
                            <h5 class="card-title mb-0">
                                @eventItem.Name
                            </h5>
                        </div>

                        <!-- Event information -->
                        <div class="card-body">

                            <p class="text-muted">
                                @eventItem.Description
                            </p>

                            <hr />

                            <p class="mb-2">
                                <strong>Event Date:</strong><br />
                                @eventItem.EventDate.ToString("dd MMMM yyyy")
                            </p>

                            <p class="mb-2">
                                <strong>Location:</strong><br />
                                @eventItem.Location
                            </p>

                            <p class="mb-2">
                                <strong>Distance:</strong><br />
                                @eventItem.DistanceKm.ToString("0.##") km
                            </p>

                            <p class="mb-2">
                                <strong>Event Type:</strong><br />
                                @eventItem.EventType
                            </p>

                            <p class="mb-2">
                                <strong>Organiser:</strong><br />
                                @(string.IsNullOrWhiteSpace(eventItem.OrganiserName)
                                                        ? "Not available"
                                                        : eventItem.OrganiserName)
                    </p>

                            <p class="mb-0">
                                <strong>Categories:</strong><br />
                                @(eventItem.Categories?.Count ?? 0) categories
                            </p>

                        </div>

                        <!-- Event card buttons -->
                        <div class="card-footer bg-white">

                            <div class="d-flex flex-wrap gap-2">

                                <a asp-controller="Events"
                                   asp-action="Details"
                                   asp-route-id="@eventItem.EventId"
                                   class="btn btn-outline-primary btn-sm">
                                    View Details
                                </a>

                        @if (isOrganiser)
                                {
                                    <a asp-controller="Events"
                                       asp-action="Edit"
                                       asp-route-id="@eventItem.EventId"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <a asp-controller="Events"
                                       asp-action="Delete"
                                       asp-route-id="@eventItem.EventId"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>
                                }

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>
