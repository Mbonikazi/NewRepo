@model RaceDay.Mvc.ViewModels.CreateEnrolmentViewModel

@{
    ViewData["Title"] = "Enrol in Event";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white p-3">
                    <h4 class="mb-0">Enrol in Event</h4>
                </div>

                <div class="card-body p-4">

                    <div asp-validation-summary="All"
                         class="text-danger mb-3"></div>

                    <form asp-controller="Enrolments"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="EventId" />

                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                Select Event Category
                            </label>

                            <select asp-for="CategoryId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Choose a Category --
                                </option>

                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.CategoryId">
                                        @category.Name -
                                        R @category.EntryFee.ToString("0.00")
                                    </option>
                                }
                            </select>

                            <span asp-validation-for="CategoryId"
                                  class="text-danger"></span>
                        </div>

                        <div class="alert alert-info">
                            Please make sure you select the correct category
                            before submitting your enrolment.
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-success">
                                Confirm Enrolment
                            </button>

                            <a asp-controller="Events"
                               asp-action="Details"
                               asp-route-id="@Model.EventId"
                               class="btn btn-secondary">
                                Cancel
                            </a>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}