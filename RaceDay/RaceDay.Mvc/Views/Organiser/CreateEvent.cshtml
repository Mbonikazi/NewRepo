@model RaceDay.Contracts.CreateEventRequest

@{
    ViewData["Title"] = "Create Event";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold">Create a New Event</h2>
        <p class="text-muted">Fill in the details below to add a new event to RaceDay.</p>
    </div>

    <div class="row">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <!-- The enctype is CRITICAL for file uploads -->
                    <form asp-action="CreateEvent" method="post" enctype="multipart/form-data">

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">Event Name</label>
                            <input asp-for="Name" class="form-control" placeholder="e.g. Cape Town Marathon" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Description</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Describe the event..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="EventDate" class="form-label fw-bold">Date</label>
                                <input asp-for="EventDate" type="date" class="form-control" />
                                <span asp-validation-for="EventDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="DistanceKm" class="form-label fw-bold">Distance (km)</label>
                                <input asp-for="DistanceKm" type="number" step="0.1" class="form-control" />
                                <span asp-validation-for="DistanceKm" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Location" class="form-label fw-bold">Location</label>
                            <input asp-for="Location" class="form-control" placeholder="e.g. Sea Point Promenade" />
                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EventType" class="form-label fw-bold">Event Type</label>
                            <select asp-for="EventType" class="form-select">
                                <option value="">-- Select Type --</option>
                                <option value="Road">Road</option>
                                <option value="Trail">Trail</option>
                                <option value="Cycling">Cycling</option>
                            </select>
                            <span asp-validation-for="EventType" class="text-danger"></span>
                        </div>

                        <!-- Azure Blob Storage Upload Input -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">Event Banner Image (Optional)</label>
                            <input type="file" name="bannerFile" class="form-control" accept="image/*" />
                            <div class="form-text">Upload a picture for the event.</div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">Create Event</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>