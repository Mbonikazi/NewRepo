@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container py-4">

    <!-- Dashboard heading -->
    <div class="mb-4">
        <h2 class="fw-bold">Organiser Dashboard</h2>

        <p class="text-muted">
            Welcome, @Model.OrganiserName!
            Manage your RaceDay events and participants from here.
        </p>
    </div>

    <!-- Success message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- Error message -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    <!-- Statistics cards -->
    <div class="row g-4 mb-4">

        <div class="col-md-6 col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h6 class="text-muted">Total Events</h6>

                    <h2 class="fw-bold text-primary">
                        @Model.TotalEvents
                    </h2>

                    <p class="mb-0 text-muted">
                        Events created by you.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body p-4">
                    <h6 class="text-muted">Total Participants</h6>

                    <h2 class="fw-bold text-success">
                        @Model.TotalParticipants
                    </h2>

                    <p class="mb-0 text-muted">
                        Participants registered for your events.
                    </p>
                </div>
            </div>
        </div>

    </div>

    <!-- Management sections -->
    <h4 class="fw-bold mb-3">Event Management</h4>

    <div class="row g-4 mb-4">

        <!-- Manage Events -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body p-4">
                    <h5 class="card-title">Manage Events</h5>

                    <p class="card-text text-muted">
                        Create new events, view existing events,
                        update event information and delete events.
                    </p>

                    <a asp-controller="Events"
                       asp-action="Index"
                       class="btn btn-primary">
                        Manage Events
                    </a>
                </div>
            </div>
        </div>

        <!-- Create Event -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body p-4">
                    <h5 class="card-title">Create Event</h5>

                    <p class="card-text text-muted">
                        Add a new race or sporting event to RaceDay.
                    </p>

                    <a asp-controller="Organiser"
                       asp-action="CreateEvent"
                       class="btn btn-success">
                        Create New Event
                    </a>
                </div>
            </div>
        </div>

        <!-- Categories -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body p-4">
                    <h5 class="card-title">Manage Categories</h5>

                    <p class="card-text text-muted">
                        Manage event categories, age groups
                        and entry fees.
                    </p>

                    <a asp-controller="Categories"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        View Categories
                    </a>
                </div>
            </div>
        </div>

        <!-- Enrolments -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body p-4">
                    <h5 class="card-title">Manage Enrolments</h5>

                    <p class="card-text text-muted">
                        View participants who have entered
                        your events and manage their enrolments.
                    </p>

                    <a asp-controller="Enrolments"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        View Enrolments
                    </a>
                </div>
            </div>
        </div>

        <!-- Results -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm h-100">
                <div class="card-body p-4">
                    <h5 class="card-title">Manage Results</h5>

                    <p class="card-text text-muted">
                        Record race finishing times and
                        participants' finishing positions.
                    </p>

                    <a asp-controller="Results"
                       asp-action="Index"
                       class="btn btn-outline-primary">
                        Manage Results
                    </a>
                </div>
            </div>
        </div>

    </div>

    <!-- Upcoming events -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">Upcoming Events</h5>
        </div>

        <div class="card-body">

            <!-- FIXED THIS LINE: Replaced .Any() with .Count == 0 -->
            @if (Model.UpcomingEvents == null || Model.UpcomingEvents.Count == 0)
            {
                <p class="text-muted mb-0">
                    No upcoming events available.
                </p>
            }
            else
            {
                <ul class="list-group list-group-flush">

                    @foreach (var eventName in Model.UpcomingEvents)
                    {
                        <li class="list-group-item">
                            <i class="bi bi-calendar-event me-2"></i>
                            @eventName
                        </li>
                    }

                </ul>
            }

            <div class="mt-3">
                <a asp-controller="Events"
                   asp-action="Index"
                   class="btn btn-sm btn-outline-primary">
                    View All Events
                </a>
            </div>

        </div>
    </div>
</div>
