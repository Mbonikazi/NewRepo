@model RaceDay.Contracts.CreateCategoryRequest

@{
    ViewData["Title"] = "Create Category";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Create Event Category</h4>
                </div>

                <div class="card-body">

                    <form asp-controller="Categories"
                          asp-action="Create"
                          asp-route-eventId="@ViewBag.EventId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">
                                Category Name
                            </label>
                            <input asp-for="Name" class="form-control"
                                   placeholder="e.g. 5km Fun Run" />
                            <span asp-validation-for="Name"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">
                                Description
                            </label>
                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Describe this category"></textarea>
                            <span asp-validation-for="Description"
                                  class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MinAge" class="form-label">
                                    Minimum Age
                                </label>
                                <input asp-for="MinAge"
                                       type="number"
                                       class="form-control" />
                                <span asp-validation-for="MinAge"
                                      class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="MaxAge" class="form-label">
                                    Maximum Age
                                </label>
                                <input asp-for="MaxAge"
                                       type="number"
                                       class="form-control" />
                                <span asp-validation-for="MaxAge"
                                      class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EntryFee" class="form-label">
                                Entry Fee (R)
                            </label>
                            <input asp-for="EntryFee"
                                   type="number"
                                   step="0.01"
                                   min="0"
                                   class="form-control" />
                            <span asp-validation-for="EntryFee"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                Create Category
                            </button>

                            <a asp-controller="Categories"
                               asp-action="Index"
                               asp-route-eventId="@ViewBag.EventId"
                               class="btn btn-secondary">
                                Cancel
                            </a>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}