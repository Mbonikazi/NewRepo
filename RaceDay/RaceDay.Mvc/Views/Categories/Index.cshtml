@model RaceDay.Mvc.ViewModels.CategoriesIndexViewModel

@{
    ViewData["Title"] = "Manage Categories";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">
        <div>
            <h2 class="fw-bold">Manage Categories</h2>
            <p class="text-muted">
                Create and manage categories for your sporting events.
            </p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <!-- Select an event -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Select Event</h5>
        </div>

        <div class="card-body">
            <form asp-controller="Categories"
                  asp-action="Index"
                  method="get">

                <label for="eventId" class="form-label">
                    Choose an event
                </label>

                <div class="row">
                    <div class="col-md-8">
                        <select name="eventId"
                                id="eventId"
                                class="form-select"
                                required>

                            <option value="">-- Select an Event --</option>

                            @foreach (var eventItem in Model.Events)
                            {
                                if (Model.SelectedEventId == eventItem.EventId)
                                {
                                    <option value="@eventItem.EventId" selected>
                                        @eventItem.Name
                                    </option>
                                }
                                else
                                {
                                    <option value="@eventItem.EventId">
                                        @eventItem.Name
                                    </option>
                                }
                            }

                        </select>
                    </div>

                    <div class="col-md-4 mt-2 mt-md-0">
                        <button type="submit" class="btn btn-primary">
                            Load Categories
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model.SelectedEventId.HasValue)
    {
        <div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
            <h4 class="fw-bold">Event Categories</h4>

            <a asp-controller="Categories"
               asp-action="Create"
               asp-route-eventId="@Model.SelectedEventId"
               class="btn btn-success">
                + Add Category
            </a>
        </div>

        @if (Model.Categories == null || !Model.Categories.Any())
        {
            <div class="card shadow-sm text-center p-5">
                <div class="card-body">
                    <h5>No Categories Available</h5>
                    <p class="text-muted">
                        This event does not have any categories yet.
                    </p>

                    <a asp-controller="Categories"
                       asp-action="Create"
                       asp-route-eventId="@Model.SelectedEventId"
                       class="btn btn-success">
                        Create First Category
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Category Name</th>
                            <th>Description</th>
                            <th>Minimum Age</th>
                            <th>Maximum Age</th>
                            <th>Entry Fee</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var category in Model.Categories)
                        {
                            <tr>
                                <td class="fw-bold">@category.Name</td>
                                <td>@category.Description</td>
                                <td>@category.MinAge</td>
                                <td>@category.MaxAge</td>
                                <td>@category.EntryFee.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-ZA"))</td>
                                <td>
                                    <div class="d-flex flex-wrap gap-2">

                                        <a asp-controller="Categories"
                                           asp-action="Edit"
                                           asp-route-id="@category.CategoryId"
                                           asp-route-eventId="@Model.SelectedEventId"
                                           class="btn btn-warning btn-sm">
                                            Edit
                                        </a>

                                        <form asp-controller="Categories"
                                              asp-action="Delete"
                                              method="post"
                                              onsubmit="return confirm('Are you sure you want to delete this category?');">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@category.CategoryId" />

                                            <input type="hidden"
                                                   name="eventId"
                                                   value="@Model.SelectedEventId" />

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm">
                                                Delete
                                            </button>
                                        </form>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info">
            Please select an event above to view and manage its categories.
        </div>
    }

</div>
